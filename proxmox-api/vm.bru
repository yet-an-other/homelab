meta {
  name: vm
  type: http
  seq: 3
}

get {
  url: https://proxmox.bdgn.me/api2/json/nodes/:node/:vmtype/:vmid/status/current
  body: none
  auth: none
}

params:path {
  vmid: 10212
  vmtype: qemu
  node: prox-n1
}

headers {
  Authorization: PVEAPIToken={{login}}={{secret}}
}

settings {
  encodeUrl: true
  timeout: 0
}
