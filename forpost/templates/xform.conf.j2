# Public xform endpoint. Authentication is intentionally left to xform.
server {
        listen 9443 ssl;
        listen [::]:9443 ssl;

        server_name {{ forpost.domain }};

        ssl_certificate /usr/ssl/fullchain.crt;
        ssl_certificate_key /usr/ssl/certificate.key;

        access_log /var/log/nginx/xform.access.log;
        error_log /var/log/nginx/xform.error.log;

        location / {
                # No URI component: xform serves the SPA and API at one origin.
                proxy_pass http://127.0.0.1:9090;
                proxy_set_header Host              $host;
                proxy_set_header X-Real-IP         $remote_addr;
                proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
                proxy_set_header X-Forwarded-Proto $scheme;
        }
}
