{#-
  forpost xray config — rendered by create-forpost.yaml to /usr/local/etc/xray/config.json.

  Render-time contract (SPEC §6): every user has name + uuid; names unique.
  The 1/0 below only renders (and fails) when a check is violated.
-#}
{%- for u in forpost.users -%}
{%- if u.name is undefined or u.name | length == 0 or u.uuid is undefined or u.uuid | length == 0 -%}
{{ 1/0 }}{# ERROR: every forpost user must have a non-empty name and uuid #}
{%- endif -%}
{%- endfor -%}
{%- set names = forpost.users | map(attribute='name') | list -%}
{%- if names | length != names | unique | list | length -%}
{{ 1/0 }}{# ERROR: forpost user names must be unique #}
{%- endif -%}
{%- set privileged = forpost.users | selectattr('privileged') | map(attribute='name') | list -%}
{
    "log": {
        "loglevel": "warning",
        "access": "/var/log/xray/access.log",
        "error": "/var/log/xray/error.log"
    },
    "inbounds": [
        {
            "tag": "vless-reality",
            "listen": "127.0.0.1",
            "port": 20001,
            "protocol": "vless",
            "settings": {
                "clients": [
{%- for u in forpost.users %}
                    {
                        "id": "{{ u.uuid }}",
                        "flow": "xtls-rprx-vision",
                        "email": "{{ u.name }}"
                    }{{ "," if not loop.last }}
{%- endfor %}
                ],
                "decryption": "none"
            },
            "streamSettings": {
                "network": "tcp",
                "security": "reality",
                "realitySettings": {
                    "show": false,
                    "dest": "127.0.0.1:8443",
                    "serverNames": [
                        "{{ forpost.server_name }}"
                    ],
                    "privateKey": "{{ forpost.private_key }}",
                    "shortIds": {{ forpost.short_ids | to_json }}
                }
            },
            "sniffing": {
                "enabled": true,
                "destOverride": ["http", "tls"],
                "routeOnly": true
            }
        }
    ],
    "outbounds": [
        {
            "tag": "alwyzon",
            "protocol": "vless",
            "settings": {
                "address": "{{ forpost.alwyzon.address }}",
                "port": {{ forpost.alwyzon.port | int }},
                "id": "{{ forpost.alwyzon.uuid }}",
                "encryption": "none",
                "flow": "xtls-rprx-vision"
            },
            "streamSettings": {
                "network": "tcp",
                "security": "reality",
                "realitySettings": {
                    "serverName": "{{ forpost.alwyzon.server_name }}",
                    "fingerprint": "chrome",
                    "password": "{{ forpost.alwyzon.public_key }}",
                    "shortId": "{{ forpost.alwyzon.short_id }}"
                }
            }
        },
        {
            "tag": "bastion",
            "protocol": "vless",
            "settings": {
                "address": "{{ forpost.bastion.address }}",
                "port": {{ forpost.bastion.port | int }},
                "id": "{{ forpost.bastion.uuid }}",
                "encryption": "none",
                "flow": "xtls-rprx-vision"
            },
            "streamSettings": {
                "network": "tcp",
                "security": "reality",
                "realitySettings": {
                    "serverName": "{{ forpost.bastion.server_name }}",
                    "fingerprint": "chrome",
                    "password": "{{ forpost.bastion.public_key }}",
                    "shortId": "{{ forpost.bastion.short_id }}"
                }
            }
        },
        {
            "tag": "blocked",
            "protocol": "blackhole",
            "settings": {
                "response": {
                    "type": "none"
                }
            }
        }
    ],
    "routing": {
        "domainStrategy": "AsIs",
        "rules": [
{%- if privileged | length > 0 %}
            {
                "type": "field",
                "user": {{ privileged | to_json }},
                "domain": ["domain:bdgn.me"],
                "outboundTag": "bastion"
            },
            {
                "type": "field",
                "user": {{ privileged | to_json }},
                "ip": ["192.168.0.0/16"],
                "outboundTag": "bastion"
            },
{%- endif %}
            {
                "type": "field",
                "ip": ["192.168.0.0/16"],
                "outboundTag": "blocked"
            },
            {
                "type": "field",
                "network": "tcp,udp",
                "outboundTag": "alwyzon"
            }
        ]
    }
}
