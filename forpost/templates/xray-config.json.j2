{#-
  xray-config.json.j2 — forpost xray config (SPEC §6).

  #10..#13 landed the inbound + nginx entry; #11 chained the catch-all via
  alwyzon. #12 (this config): the full routing table — the bastion outbound
  and the privileged split. Privilege is the AUTHENTICATED email tag
  (SPEC §1): privileged users get domain:bdgn.me and 192.168.0.0/16 via
  bastion; 192.168.0.0/16 is blocked for everyone else; everything else
  (incl. non-privileged bdgn.me — the domain has public records) goes to
  alwyzon. Outbound order: alwyzon, bastion, blocked — defense-in-depth;
  freedom stays last, unused, as a debugging aid. The DNS module only
  handles privileged clients' hijacked A/AAAA queries; bastion and alwyzon
  resolve ordinary proxied traffic (SPEC §6).

  #12 + DNS hijack: privileged users' plain-DNS queries (UDP/TCP 53, any
  # resolver — 1.1.1.1 included) enter the `dns-internal` outbound. In the
  # pinned xray 26.3.27, that outbound resolves A/AAAA via the built-in DNS
  # module: bdgn.me uses 192.168.30.1, and the tagged module query is routed
  # through bastion; other names use 1.1.1.1 through alwyzon. Thus client DNS
  # settings stop mattering for the split-horizon zone. DoH/DoT (853/443)
  # can't be caught this way — those clients still need remote DNS
  # 192.168.30.1.
  # The sniff-rewrite (dropping routeOnly) is deliberately NOT enabled yet.
  # Bastion side (vm-bastion) routes privileged domain:bdgn.me traffic to
  # wg-in via its own vlessRoute-marked domain rule — clients passing domains
  # through the tunnel (mobile apps) depend on it.

  The inbound sits behind the nginx SNI map (#13): nginx owns public 443
  and ssl_prereads the SNI here. The reality `dest` (127.0.0.1:8443) is the
  nginx fallback vhost. dest MUST be a live TLS 1.3 endpoint: current xray
  mirrors dest's handshake even for fully authenticated clients — a dead
  dest kills valid sessions too (diagnosed in #10).

  PROXY protocol, both hops: the nginx stream server sends PROXY v1
  to its upstreams, so this inbound sets sockopt.acceptProxyProtocol and
  sees the real client address (logs, routing) instead of 127.0.0.1;
  realitySettings.xver: 1 sends PROXY v1 on to the dest, where the fallback
  vhost listens proxy_protocol and restores the real address for its
  upstream headers. Both pairs must stay in lockstep — one-sided flips
  drop every connection (nginx/xray) or kill dest mirroring (#10) —
  asserted on every apply by tests/proxy-protocol.sh, which the play runs
  after rendering, before any unit flips a pair.

  Outbound reality field naming: the pinned xray (v26.3.27) renamed the
  client-side publicKey field to `password` — the value is the upstream's
  x25519 PUBLIC key — and `network` tcp to `raw` (tcp still accepted).
  The flat outbound form (no vnext) is current; vnext still works.
  (research: docs/research/xray-vlessroute.md Q4)

  Rendered by create-forpost.yaml to /usr/local/etc/xray/config.json before
  units run; 40-xray.sh validates (`xray -test`) and restarts on change.
-#}
{%- set clients = [] -%}
{%- for u in forpost.users -%}
  {#- SPEC §6 render-time assert: every user has name + uuid -#}
  {%- set _ = clients.append({"id": u.uuid | mandatory("forpost user is missing uuid"), "flow": "xtls-rprx-vision", "email": u.name | mandatory("forpost user is missing name")}) -%}
{%- endfor -%}
{%- set privileged = forpost.users | selectattr('privileged') | map(attribute='name') | list -%}
{#- Client-facing names (SPEC §6): the primary server_name plus the optional
    backup domain (inventory `forpost.backup_domain`, research:
    docs/research/xray-multidomain.md). Reality gates only the auth attempt on
    SNI membership — one key/user set serves every listed name; every other
    SNI still gets dest mirroring. Omit the var and nothing changes. -#}
{%- set server_names = [forpost.server_name] -%}
{%- if forpost.backup_domain is defined -%}
  {%- set _ = server_names.append(forpost.backup_domain) -%}
{%- endif -%}
{#- Bastion routes internal IPs (192.168/16) via wg-in only for UUIDs
    carrying the vlessRoute "1" marker (group 3 = 0001). xray auth ignores
    group 3 (research Q1), so the plain registered UUID authenticates; the
    marker only selects the internal path. Derived here so the secrets hold
    the true registered credential. -#}
{%- set bu = forpost.bastion.uuid.split('-') -%}
{%- set bastion_marked_uuid = bu[0] ~ '-' ~ bu[1] ~ '-0001-' ~ bu[3] ~ '-' ~ bu[4] -%}
{#- Logging: no access/error paths — xray writes both streams to stdout/stderr,
    and the installer's foreground xray.service pipes them into journald
    (`journalctl -u xray`). loglevel filters only general messages; access
    entries are never severity-filtered (pinned v26.3.27, app/log). -#}
{%- set config = {
  "log": {
    "loglevel": "warning"
  },
  "stats": {},
  "policy": {
    "levels": {
      "0": {
        "statsUserUplink": true,
        "statsUserDownlink": true,
        "statsUserOnline": true
      }
    },
    "system": {
      "statsInboundUplink": true,
      "statsInboundDownlink": true,
      "statsOutboundUplink": true,
      "statsOutboundDownlink": true
    }
  },
  "api": {
    "tag": "api",
    "listen": "127.0.0.1:8080",
    "services": ["StatsService", "HandlerService"]
  },
  "dns": {
    "tag": "dns-query",
    "servers": [
      {
        "address": "192.168.30.1",
        "domains": ["domain:bdgn.me"],
        "skipFallback": true
      },
      "1.1.1.1"
    ]
  },
  "inbounds": [
    {
      "tag": "vless-reality",
      "listen": "127.0.0.1",
      "port": 20001,
      "protocol": "vless",
      "settings": {
        "clients": clients,
        "decryption": "none"
      },
      "streamSettings": {
        "network": "tcp",
        "security": "reality",
        "sockopt": { "acceptProxyProtocol": true },
        "realitySettings": {
          "show": false,
          "dest": "127.0.0.1:8443",
          "xver": 1,
          "serverNames": server_names,
          "privateKey": forpost.private_key,
          "shortIds": forpost.short_ids
        }
      },
      "sniffing": {
        "enabled": true,
        "destOverride": ["http", "tls"],
        "routeOnly": true
      }
    }
  ],
  "outbounds": [
    {
      "tag": "alwyzon",
      "protocol": "vless",
      "settings": {
        "address": forpost.alwyzon.address | mandatory("forpost.alwyzon.address is required"),
        "port": forpost.alwyzon.port | mandatory("forpost.alwyzon.port is required"),
        "id": forpost.alwyzon.uuid | mandatory("forpost.alwyzon.uuid is required"),
        "encryption": "none",
        "flow": "xtls-rprx-vision"
      },
      "streamSettings": {
        "network": "tcp",
        "security": "reality",
        "realitySettings": {
          "serverName": forpost.alwyzon.server_name | mandatory("forpost.alwyzon.server_name is required"),
          "fingerprint": "chrome",
          "password": forpost.alwyzon.public_key | mandatory("forpost.alwyzon.public_key is required"),
          "shortId": forpost.alwyzon.short_id | mandatory("forpost.alwyzon.short_id is required")
        }
      }
    },
    {
      "tag": "bastion",
      "protocol": "vless",
      "settings": {
        "address": forpost.bastion.address | mandatory("forpost.bastion.address is required"),
        "port": forpost.bastion.port | mandatory("forpost.bastion.port is required"),
        "id": bastion_marked_uuid,
        "encryption": "none",
        "flow": "xtls-rprx-vision"
      },
      "streamSettings": {
        "network": "tcp",
        "security": "reality",
        "realitySettings": {
          "serverName": forpost.bastion.server_name | mandatory("forpost.bastion.server_name is required"),
          "fingerprint": "chrome",
          "password": forpost.bastion.public_key | mandatory("forpost.bastion.public_key is required"),
          "shortId": forpost.bastion.short_id | mandatory("forpost.bastion.short_id is required")
        }
      }
    },
    {
      "tag": "blocked",
      "protocol": "blackhole",
      "settings": { "response": { "type": "none" } }
    },
    {
      "tag": "dns-internal",
      "protocol": "dns",
      "settings": {
        "nonIPQuery": "reject"
      }
    },
    {
      "tag": "direct",
      "protocol": "freedom"
    }
  ],
  "routing": {
    "domainStrategy": "AsIs",
    "rules": [
      {
        "type": "field",
        "inboundTag": ["dns-query"],
        "ip": ["192.168.30.1/32"],
        "outboundTag": "bastion"
      },
      {
        "type": "field",
        "inboundTag": ["dns-query"],
        "outboundTag": "alwyzon"
      },
      {
        "type": "field",
        "user": privileged,
        "network": "udp,tcp",
        "port": "53",
        "outboundTag": "dns-internal"
      },
      {
        "type": "field",
        "user": privileged,
        "domain": ["domain:bdgn.me"],
        "outboundTag": "bastion"
      },
      {
        "type": "field",
        "user": privileged,
        "ip": ["192.168.0.0/16"],
        "outboundTag": "bastion"
      },
      {
        "type": "field",
        "ip": ["192.168.0.0/16"],
        "outboundTag": "blocked"
      },
      {
        "type": "field",
        "network": "tcp,udp",
        "outboundTag": "alwyzon"
      }
    ]
  }
} -%}
{{ config | to_nice_json }}
