# Fallback vhost: TLS probes that present the Reality SNI ({{ forpost.server_name }})
# but are not valid VLESS clients are forwarded here by xray (reality dest) and see
# the real public https://speed.bdgn.me site (served by frontgate), so the node
# looks like a genuine speedtest server. Host is preserved towards the upstream
# per frontgate's fallback.conf conventions.

# set limit for trottling
#
limit_req_zone " " zone=global:1m rate=5r/s;

server {
        listen 127.0.0.1:8443 ssl;

        server_name {{ forpost.server_name }};

        http2 on;

        ssl_certificate /usr/ssl/fullchain.crt;
        ssl_certificate_key /usr/ssl/certificate.key;

        access_log /var/log/nginx/fallback.access.log;
        error_log /var/log/nginx/fallback.error.log;

        client_max_body_size 40M;

        location / {
                resolver 1.1.1.1 valid=30s;
                set $upstream https://speed.bdgn.me;
                limit_req zone=global burst=20 nodelay;

                proxy_pass $upstream;
                proxy_ssl_server_name on;
                proxy_set_header Host             $host;
                proxy_set_header X-Real-IP        $remote_addr;
                proxy_set_header X-Forwarded-For  $proxy_add_x_forwarded_for;
        }
}
