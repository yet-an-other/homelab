# Fallback vhost (SPEC §7): xray's reality `dest`. Probes that pass the SNI
# map but fail Reality auth land here and see the genuine speed.bdgn.me
# content, reverse-proxied from the real public site (served by frontgate).
# Host is preserved towards the upstream per frontgate's fallback.conf
# conventions; the upstream vhost is selected by our TLS SNI.

server {
        listen 127.0.0.1:8443 ssl;
        http2 on;

        server_name {{ forpost.server_name }};

        ssl_certificate /usr/ssl/fullchain.crt;
        ssl_certificate_key /usr/ssl/certificate.key;

        access_log /var/log/nginx/fallback.access.log;
        error_log /var/log/nginx/fallback.error.log;

        location / {
                resolver 1.1.1.1 valid=300s;
                set $fallback_upstream https://speed.bdgn.me;

                proxy_pass $fallback_upstream;
                proxy_ssl_server_name on;
                proxy_ssl_name speed.bdgn.me;
                proxy_set_header Host             $host;
                proxy_set_header X-Real-IP        $remote_addr;
                proxy_set_header X-Forwarded-For  $proxy_add_x_forwarded_for;
        }
}
