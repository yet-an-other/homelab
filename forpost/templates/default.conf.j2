# Default site: anything that is not the Reality SNI lands here (418).
# Frontgate pattern (frontgate/default.conf); cert issued via add-ssl-certificate.yaml.

server {
        listen 127.0.0.1:20000 ssl default_server;
        http2 on;

        server_name "" _;

        ssl_certificate /usr/ssl/fullchain.crt;
        ssl_certificate_key /usr/ssl/certificate.key;

        access_log /var/log/nginx/default.access.log;
        error_log /var/log/nginx/default.error.log;

        return 418;
}
