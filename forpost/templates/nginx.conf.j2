user  www-data;
worker_processes auto;
worker_rlimit_nofile 200000;

error_log  /var/log/nginx/error.log notice;
pid        /run/nginx.pid;

# libnginx-mod-stream drops its load_module symlink here (41-nginx.sh installs it)
include /etc/nginx/modules-enabled/*.conf;

events {
    worker_connections  16384;
}


http {
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;

    log_format  main  '$remote_addr - $remote_user [$time_local] "$request" '
                      '$status $body_bytes_sent "$http_referer" '
                      '"$http_user_agent" "$http_x_forwarded_for"';

    access_log  /var/log/nginx/access.log  main;

    sendfile        on;

    keepalive_timeout  65;

    include /etc/nginx/conf.d/*.conf;
}


## stream: the client-facing 443 (frontgate arrangement, SPEC §7).
## ssl_preread the SNI: the live VLESS+Reality inbound goes to xray,
## everything else gets the 418 default site. The map anticipates more
## inbounds (SPEC §12 fog: xhttp, tcp+tls).
##
## proxy_protocol on: every upstream of this server block (xray AND the
## default site) receives a PROXY protocol v1 header so xray sees the real
## client address instead of 127.0.0.1 (xray: sockopt.acceptProxyProtocol;
## default site: listen proxy_protocol — both sides must match, verified by
## tests/proxy-protocol.sh).

stream {

        log_format stream '$remote_addr - - [$time_local] $protocol '
                    '$status $bytes_sent $bytes_received '
                    '$upstream_addr "$ssl_preread_server_name" '
                    '"$ssl_preread_protocol" "$ssl_preread_alpn_protocols"';

        access_log /var/log/nginx/stream.log stream;
        error_log /var/log/nginx/stream.error.log;

        map $ssl_preread_server_name $upstream_map {

                default                 main;
{#- client-facing names: primary server_name plus the optional backup
    domain (inventory forpost.backup_domain) — same inbound, same users
    (SPEC §6/§7, docs/research/xray-multidomain.md). Built as explicit
    strings because ansible renders with trim_blocks — inline loops
    collapse their newlines. -#}
{%- set sni_names = [forpost.server_name] -%}
{%- if forpost.backup_domain is defined -%}
  {%- set _ = sni_names.append(forpost.backup_domain) -%}
{%- endif -%}
{%- set sni_map = sni_names | map('regex_replace', '^(.*)$', '                \\1     vless-reality;') | list -%}
{{ '\n' ~ sni_map | join('\n') }}
        }


        upstream main {
                server 127.0.0.1:20000; # default site (418)
        }

        upstream vless-reality {
                server 127.0.0.1:20001; # xray
        }

        server {
                listen 443      reuseport;
                listen [::]:443 reuseport;
                proxy_pass      $upstream_map;
                ssl_preread     on;
                proxy_protocol  on;

                proxy_connect_timeout 10s;
                proxy_timeout 1h;
                proxy_socket_keepalive on;
                proxy_half_close on;
        }
}
