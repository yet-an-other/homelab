all:
  vars:
    # Global variables available to all hosts
    cluster_env: proxmox
    root_domain_name: "{{ domain_name }}" 
    main_domain_name: "kuber.{{ domain_name }}"
    ansible_python_interpreter: "auto_silent"
  children:
    k8s-nodes:
      hosts:
{%- for node in nodes %} 
        {{ node.name }}:
          ansible_host: {{ node.ansible_host }}
          ansible_user: ib
          ansible_ssh_private_key_file: {{ node.ansible_ssh_private_key_file }}
          public_ip: {{ node.public_ip }}
          internal_ip: {{ node.ip }}
          role: {{ node.role }}
 
{%- endfor %}

    control-nodes:
      hosts:
{%- for node in nodes if node.role == 'control' %} 
        {{ node.name }}: {}
{%- endfor %}

    worker-nodes:
      hosts:
{%- for node in nodes if node.role == 'worker' %} 
        {{ node.name }}: {}
{%- endfor %}